{
  "manifest_version": 3,
  "name": "GuideFlow - Local Step Recorder",
  "version": "1.0.0",
  "description": "Capture screen and highlight click coordinates locally to generate step-by-step interactive documentation.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
